# ==============================================================================
# Rove Workstation · Environment Variable Reference (.env.example)
# Runtime data defaults to ~/.config/walking-workstation (or WORKSTATION_DATA)
# ==============================================================================

# Data directory for SQLite WAL database, auth hashes, VAPID keys, and snapshots
# WORKSTATION_DATA=/Users/yourname/.config/walking-workstation

# Listening port for the FastAPI control plane
WORKSTATION_PORT=8765

# Optional: Colon-separated project root directories allowed on initial bootstrap
# ROVE_ALLOWED_ROOTS=/Users/yourname/Projects:/Users/yourname/Documents/Codex

# Optional: Override auto-detected LAN IP and public HTTPS gateway URL
# ROVE_LAN_IP=192.168.1.100
# ROVE_PUBLIC_URL=https://rove.example.com

# Optional: Trusted reverse-proxy IPs for X-Forwarded-For / X-Forwarded-Proto
ROVE_TRUSTED_PROXIES=127.0.0.1

# Optional: RFC 8292 VAPID contact subject for self-hosted Web Push notifications
ROVE_VAPID_SUBJECT=mailto:admin@example.com
